# Copiar como .env y completar. Todas las líneas son opcionales.

# ---- Versiones ----
APP_VERSION=0.1.0
OLLAMA_VERSION=latest
CADDY_VERSION=2

# ---- Imagen de la app ----
# Local (se construye en esta PC):   ingenia-salud-triage
# Desde un registro (servidor):      ghcr.io/<usuario-o-equipo>/ingenia-salud-triage
HRRG_IMAGEN=ingenia-salud-triage

# ---- Acceso desde la red (Caddy) ----
# Nombres y/o IP del servidor, separados por "coma y espacio", entre comillas.
# Ejemplo: HRRG_SITIO="triage.hrrg.local, 192.168.1.50, localhost"
HRRG_SITIO="localhost"
# Certificado: internal (lo genera Caddy) o el del hospital:
#   HRRG_TLS="/certs/cert.pem /certs/key.pem"   (con comillas; copiar los archivos en certificados\)
HRRG_TLS=internal
# IP del servidor (tiene que estar también en HRRG_SITIO). Necesaria para entrar por IP.
HRRG_IP_SERVIDOR=localhost
HRRG_PUERTO_HTTPS=443
HRRG_PUERTO_HTTP=80
HRRG_PUERTO_LOCAL=5000

# ---- IA ----
MEDGEMMA_MODELO=medgemma:4b

# ---- API para el sistema del hospital (opcional) ----
HRRG_API_HOSPITAL_TOKEN=
